# Shared
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
UPSTREAM_TIMEOUT_MS=5000

# Browser GraphQL endpoint (used by Vite and the web Docker build)
VITE_GRAPHQL_URL=http://localhost:4000/graphql

# ---------------------------------------------------------------------------
# Local npm development (services run on the host)
# ---------------------------------------------------------------------------
# AUTH_SERVICE_URL=http://localhost:4001
# CRM_SERVICE_URL=http://localhost:4002
# MONGO_URI_AUTH=mongodb://localhost:27017/crm-auth
# MONGO_URI_CRM=mongodb://localhost:27017/crm-data
#
# Each service reads PORT and MONGO_URI from its own process environment.
# Defaults in code are already suitable for localhost development:
#   auth-service  PORT=4001  MONGO_URI=mongodb://localhost:27017/crm-auth
#   crm-service   PORT=4002  MONGO_URI=mongodb://localhost:27017/crm-data
#   api-gateway   PORT=4000

# ---------------------------------------------------------------------------
# Docker Compose development (docker-compose.yml hard-codes these values)
# ---------------------------------------------------------------------------
# AUTH_SERVICE_URL=http://auth-service:4001
# CRM_SERVICE_URL=http://crm-service:4002
# MONGO_URI=mongodb://mongo:27017/crm-auth   # auth-service
# MONGO_URI=mongodb://mongo:27017/crm-data   # crm-service
